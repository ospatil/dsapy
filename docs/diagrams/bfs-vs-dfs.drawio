<mxfile>
  <diagram name="BFS vs DFS" id="bfsdfs">
    <mxGraphModel>
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <!-- BFS -->
        <mxCell id="t1" value="BFS (Level Order)" style="text;fontSize=14;fontStyle=1;sketch=0;" vertex="1" parent="1">
          <mxGeometry x="30" y="5" width="180" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="b0" value="0 ①" style="ellipse;whiteSpace=wrap;sketch=1;hachureGap=4;jiggle=2;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="80" y="35" width="55" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="b1" value="1 ②" style="ellipse;whiteSpace=wrap;sketch=1;hachureGap=4;jiggle=2;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="20" y="110" width="55" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="b2" value="2 ③" style="ellipse;whiteSpace=wrap;sketch=1;hachureGap=4;jiggle=2;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="140" y="110" width="55" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="b3" value="3 ④" style="ellipse;whiteSpace=wrap;sketch=1;hachureGap=4;jiggle=2;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="0" y="185" width="55" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="b4" value="4 ⑤" style="ellipse;whiteSpace=wrap;sketch=1;hachureGap=4;jiggle=2;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="70" y="185" width="55" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="be1" style="sketch=1;hachureGap=4;jiggle=2;" edge="1" source="b0" target="b1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="be2" style="sketch=1;hachureGap=4;jiggle=2;" edge="1" source="b0" target="b2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="be3" style="sketch=1;hachureGap=4;jiggle=2;" edge="1" source="b1" target="b3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="be4" style="sketch=1;hachureGap=4;jiggle=2;" edge="1" source="b1" target="b4" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="bord" value="Visit order: 0, 1, 2, 3, 4&#xa;(level by level)" style="text;fontSize=11;fontStyle=2;sketch=0;fontColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="20" y="245" width="180" height="30" as="geometry"/>
        </mxCell>
        <!-- DFS -->
        <mxCell id="t2" value="DFS (Depth First)" style="text;fontSize=14;fontStyle=1;sketch=0;" vertex="1" parent="1">
          <mxGeometry x="270" y="5" width="180" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="d0" value="0 ①" style="ellipse;whiteSpace=wrap;sketch=1;hachureGap=4;jiggle=2;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="320" y="35" width="55" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="d1" value="1 ②" style="ellipse;whiteSpace=wrap;sketch=1;hachureGap=4;jiggle=2;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="260" y="110" width="55" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="d2" value="2 ⑤" style="ellipse;whiteSpace=wrap;sketch=1;hachureGap=4;jiggle=2;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="380" y="110" width="55" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="d3" value="3 ③" style="ellipse;whiteSpace=wrap;sketch=1;hachureGap=4;jiggle=2;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="240" y="185" width="55" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="d4" value="4 ④" style="ellipse;whiteSpace=wrap;sketch=1;hachureGap=4;jiggle=2;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="310" y="185" width="55" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="de1" style="sketch=1;hachureGap=4;jiggle=2;" edge="1" source="d0" target="d1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de2" style="sketch=1;hachureGap=4;jiggle=2;" edge="1" source="d0" target="d2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de3" style="sketch=1;hachureGap=4;jiggle=2;" edge="1" source="d1" target="d3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de4" style="sketch=1;hachureGap=4;jiggle=2;" edge="1" source="d1" target="d4" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="dord" value="Visit order: 0, 1, 3, 4, 2&#xa;(go deep first)" style="text;fontSize=11;fontStyle=2;sketch=0;fontColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="260" y="245" width="180" height="30" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
