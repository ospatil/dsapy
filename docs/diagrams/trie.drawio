<mxfile>
  <diagram name="Trie" id="trie">
    <mxGraphModel>
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="Trie with words: app, apple, bat" style="text;fontSize=13;fontStyle=1;sketch=0;" vertex="1" parent="1">
          <mxGeometry x="30" y="0" width="280" height="22" as="geometry"/>
        </mxCell>
        <!-- Root -->
        <mxCell id="r" value="root" style="ellipse;whiteSpace=wrap;sketch=1;hachureGap=4;jiggle=2;fontSize=11;fillColor=#f5f5f5;strokeColor=#666;" vertex="1" parent="1">
          <mxGeometry x="140" y="30" width="50" height="40" as="geometry"/>
        </mxCell>
        <!-- Level 1: a, b -->
        <mxCell id="a" value="a" style="ellipse;whiteSpace=wrap;sketch=1;hachureGap=4;jiggle=2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="45" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="b" value="b" style="ellipse;whiteSpace=wrap;sketch=1;hachureGap=4;jiggle=2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="220" y="100" width="45" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="era" style="sketch=1;hachureGap=4;jiggle=2;" edge="1" source="r" target="a" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="erb" style="sketch=1;hachureGap=4;jiggle=2;" edge="1" source="r" target="b" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- Level 2: p, a -->
        <mxCell id="p" value="p" style="ellipse;whiteSpace=wrap;sketch=1;hachureGap=4;jiggle=2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="170" width="45" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="ba" value="a" style="ellipse;whiteSpace=wrap;sketch=1;hachureGap=4;jiggle=2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="220" y="170" width="45" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="eap" style="sketch=1;hachureGap=4;jiggle=2;" edge="1" source="a" target="p" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eba" style="sketch=1;hachureGap=4;jiggle=2;" edge="1" source="b" target="ba" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- Level 3: p, t -->
        <mxCell id="p2" value="p" style="ellipse;whiteSpace=wrap;sketch=1;hachureGap=4;jiggle=2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="240" width="45" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="bt" value="t" style="ellipse;whiteSpace=wrap;sketch=1;hachureGap=4;jiggle=2;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="220" y="240" width="45" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="epp" style="sketch=1;hachureGap=4;jiggle=2;" edge="1" source="p" target="p2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ebat" style="sketch=1;hachureGap=4;jiggle=2;" edge="1" source="ba" target="bt" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- app marker + branch to l, e -->
        <mxCell id="appmark" value="$" style="text;fontSize=10;fontStyle=1;sketch=0;fontColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="105" y="248" width="15" height="15" as="geometry"/>
        </mxCell>
        <!-- Level 4: l -->
        <mxCell id="l" value="l" style="ellipse;whiteSpace=wrap;sketch=1;hachureGap=4;jiggle=2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="310" width="45" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="epl" style="sketch=1;hachureGap=4;jiggle=2;" edge="1" source="p2" target="l" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- Level 5: e -->
        <mxCell id="e" value="e" style="ellipse;whiteSpace=wrap;sketch=1;hachureGap=4;jiggle=2;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="380" width="45" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="ele" style="sketch=1;hachureGap=4;jiggle=2;" edge="1" source="l" target="e" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- bat marker -->
        <mxCell id="batmark" value="bat $" style="text;fontSize=10;fontStyle=1;sketch=0;fontColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="268" y="248" width="35" height="15" as="geometry"/>
        </mxCell>
        <!-- apple marker -->
        <mxCell id="applemark" value="apple $" style="text;fontSize=10;fontStyle=1;sketch=0;fontColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="105" y="388" width="50" height="15" as="geometry"/>
        </mxCell>
        <!-- app label -->
        <mxCell id="applbl" value="app $" style="text;fontSize=10;fontStyle=1;sketch=0;fontColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="105" y="260" width="40" height="15" as="geometry"/>
        </mxCell>
        <!-- Shared prefix annotation -->
        <mxCell id="note" value="shared prefix: a-p-p" style="text;fontSize=10;fontStyle=2;sketch=0;fontColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="120" y="175" width="130" height="15" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
